# Copiá este archivo como .env para probar en tu PC.
# En GitHub, estas mismas claves van en Settings > Secrets and variables > Actions.
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit pide un User-Agent con tu usuario de Reddit, por ejemplo:
# script:discoveries-bot:v0.1 (by /u/TU_USUARIO)
REDDIT_USER_AGENT=
